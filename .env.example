# === Módulo Weekend (fim de semana de corrida) ===
# Copie para .env e preencha

# Ingest (fonte de dados) - Jolpica por padrão, sem key
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# --- Ollama Cloud ---
# Obtenha em https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=https://ollama.com

# --- Email (SMTP) ---
# Ex: Gmail (use senha de app), Outlook, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_FROM=seu_email@gmail.com
SMTP_TO=destino1@gmail.com,destino2@gmail.com
SMTP_USE_TLS=true

# --- Telegram ---
# Fale com @BotFather no Telegram para criar o bot e obter o token
# Para obter o chat_id: envie msg ao bot e acesse https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Módulo Weekend (fim de semana de corrida) ===
# Copie para .env e preencha

# Ingest (fonte de dados) - escolha: jolpica | espn | globo | openf1 | all
WEEKEND_PROVIDER=jolpica
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
ESPN_CLASSIFICACAO_URL=https://www.espn.com.br/f1/classificacao
ESPN_F1_URL=https://www.espn.com.br/f1/
GLOBO_HOME_URL=https://ge.globo.com/motor/formula-1/
GLOBO_CALENDARIO_URL=https://ge.globo.com/motor/formula-1/noticia/2026/03/14/f1-2026-veja-como-fica-calendario-sem-gps-do-bahrein-e-arabia-saudita.ghtml
OPENF1_BASE_URL=https://api.openf1.org/v1

# --- Ollama Cloud ---
# Obtenha em https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=https://ollama.com

# --- Email (SMTP) ---
# Ex: Gmail (use senha de app), Outlook, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_FROM=seu_email@gmail.com
SMTP_TO=destino1@gmail.com,destino2@gmail.com
SMTP_USE_TLS=true

# --- Telegram ---
# Fale com @BotFather no Telegram para criar o bot e obter o token
# Para obter o chat_id: envie msg ao bot e acesse https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
